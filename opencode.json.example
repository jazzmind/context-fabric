{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.8:27b-mlx",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama MLX (default)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "qwen3.8:27b-mlx": {
          "name": "Qwen3.8-27B MLX"
        }
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (expert backend)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "Qwen3.8-27B-8bit": {
          "name": "Qwen3.8-27B 8-bit (oMLX)"
        }
      }
    }
  },
  "agent": {
    "build": { "model": "ollama/qwen3.8:27b-mlx" },
    "plan": { "model": "ollama/qwen3.8:27b-mlx" }
  },
  "share": "disabled",
  "_comment_context_fabric": "Ollama is the reference/default backend. To benchmark or tune oMLX, change model/agent refs to omlx/Qwen3.8-27B-8bit and run /context-backend set omlx. Advanced DFlash/MTP/TurboQuant/ANE settings belong to oMLX, not Context Fabric core."
}
